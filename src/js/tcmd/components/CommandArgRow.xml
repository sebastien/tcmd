<box flexDirection="row" height="1" out:marginTop="runMarginTop" out:backgroundColor="rowBg" on:click="row.key!panel:select">
	<!-- A selection's item list: indented under the value column and framed
	     by the top/bottom border rows. -->
	<text when="isList" out="listSpacer" wrapMode="none"></text>
	<box when="isList" flexGrow="1" flexShrink="1" minWidth="0" flexDirection="row" columnGap="1"
	     out:border="listBorder" out:borderColor="borderFg">
		<text when="isItem" out="listMarker" width="2" out:fg="markerFg"></text>
		<text when="isItem" out="listName" flexShrink="0" out:fg="rowFg" wrapMode="none"></text>
		<text when="isItem" out="listSummary" flexGrow="1" flexShrink="1" minWidth="0" out:fg="summaryFg" wrapMode="none" truncate="true"></text>
	</box>
	<!-- An argument header: an aligned label and a bracketed value field. -->
	<box when="isArg" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" columnGap="1">
		<text out="marker" width="2" out:fg="markerFg"></text>
		<text out="name" flexShrink="0" out:fg="rowFg" wrapMode="none"></text>
		<box when="editing" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" out:backgroundColor="fieldBg" overflow="hidden">
			<text out="fieldOpen" out:fg="fieldFg"></text>
			<input inout="value" flexGrow="1" minWidth="6" height="1" out:focused="editing"></input>
			<text out="fieldClose" out:fg="fieldFg"></text>
		</box>
		<box when="!editing" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" out:backgroundColor="fieldBg" overflow="hidden">
			<text out="fieldOpen" out:fg="fieldFg"></text>
			<text out="summary" flexGrow="1" flexShrink="1" minWidth="0" out:fg="summaryFg" wrapMode="none" truncate="true"></text>
			<text out="fieldClose" out:fg="fieldFg"></text>
		</box>
	</box>
	<box when="isRun" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" columnGap="1" justifyContent="flex-end">
		<text when="hasRunError" out="runError" flexGrow="1" flexShrink="1" minWidth="0" out:fg="runErrorFg" wrapMode="none" truncate="true"></text>
		<text out="runLabel" out:fg="runFg" wrapMode="none"></text>
	</box>
	<!-- Bold color-group title; operations below it are indented. -->
	<box when="isGroup" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" paddingLeft="1">
		<text out="name" out:fg="rowFg" out:attributes="groupAttributes" wrapMode="none"></text>
	</box>
	<!-- Name-only operation row, indented beneath its group title. -->
	<box when="isOp" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" columnGap="1" paddingLeft="2">
		<text out="marker" width="2" out:fg="markerFg"></text>
		<text out="name" flexShrink="0" out:fg="rowFg" wrapMode="none"></text>
	</box>
	<!-- Picker entries retain their cursor marker and trailing kind summary. -->
	<box when="isEntry" flexDirection="row" flexGrow="1" flexShrink="1" minWidth="0" columnGap="1">
		<text out="marker" width="2" out:fg="markerFg"></text>
		<text out="name" flexShrink="0" out:fg="rowFg" wrapMode="none"></text>
		<text out="summary" flexGrow="1" flexShrink="1" minWidth="0" out:fg="summaryFg" wrapMode="none" truncate="true"></text>
	</box>
</box>
