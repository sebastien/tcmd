<!-- Root wrapper: the workspace, plus overlays positioned against the whole
     viewport. The overlays stay INSIDE this root box so keypress routing (which
     binds to it once) sees them as its focused subtree. -->
<box flexDirection="column" width="100%" height="100%" on:keypress="keys">

	<!-- Workspace wrapper: always mounted, so the root box has one stable
	     child whether the workspace or the min-size gate shows. -->
	<box flexGrow="1" flexDirection="column" overflow="hidden">

		<!-- Identity bar: the one visible trace of TinyCmd itself (the host
		     aside, everything else on screen is the user's files). "Tiny"
		     shimmers blue letter by letter, "Cmd" shimmers orange. -->
		<box flexDirection="row" height="1" paddingLeft="1" paddingRight="1" overflow="hidden">
			<text out="brandT" out:fg="brandTFg" wrapMode="none"></text>
			<text out="brandI" out:fg="brandIFg" wrapMode="none"></text>
			<text out="brandN" out:fg="brandNFg" wrapMode="none"></text>
			<text out="brandY" out:fg="brandYFg" wrapMode="none"></text>
			<text out="brandC" out:fg="brandCFg" wrapMode="none"></text>
			<text out="brandM" out:fg="brandMFg" wrapMode="none"></text>
			<text out="brandD" out:fg="brandDFg" wrapMode="none"></text>
			<text out="topBar" out:fg="topBarFg" wrapMode="none"></text>
			<box flexGrow="1" flexShrink="1" minWidth="0" overflow="hidden"></box>
			<!-- The view mode, letter by letter so each carries its gradient:
			     explorer shimmers along the Tiny blues, commander along the
			     Cmd oranges (see `modeGradient` in Frame.js). The trailing
			     slots of the shorter word are empty and take no column. -->
			<box flexDirection="row" flexShrink="0" overflow="hidden">
				<!-- Clicking the mode word flips explorer ⇄ commander. -->
				<box flexDirection="row" overflow="hidden" on:click="!view:toggleMode">
					<text when="modeHas0" out="modeL0" out:fg="modeFg0" wrapMode="none"></text>
					<text when="modeHas1" out="modeL1" out:fg="modeFg1" wrapMode="none"></text>
					<text when="modeHas2" out="modeL2" out:fg="modeFg2" wrapMode="none"></text>
					<text when="modeHas3" out="modeL3" out:fg="modeFg3" wrapMode="none"></text>
					<text when="modeHas4" out="modeL4" out:fg="modeFg4" wrapMode="none"></text>
					<text when="modeHas5" out="modeL5" out:fg="modeFg5" wrapMode="none"></text>
					<text when="modeHas6" out="modeL6" out:fg="modeFg6" wrapMode="none"></text>
					<text when="modeHas7" out="modeL7" out:fg="modeFg7" wrapMode="none"></text>
					<text when="modeHas8" out="modeL8" out:fg="modeFg8" wrapMode="none"></text>
				</box>
				<text out="topBarStatus" out:fg="topBarStatusFg" wrapMode="none"></text>
			</box>
		</box>

		<!-- Minimum-size gate: below the breakpoint the workspace is unusable. -->
		<box when="tooSmall" flexGrow="1" alignItems="center" justifyContent="center" flexDirection="column" rowGap="1">
			<text out="minSizeTitle" out:fg="titleFg"></text>
			<text out="minSizeHint" out:fg="dimFg"></text>
		</box>

		<!-- Columns: commander tiles source and destination; explorer leads
		     with the parent mirror so the current pane sits in the middle,
		     slightly wider than its neighbours. The inspector completes the
		     three columns in either mode. -->
		<box when="!tooSmall" flexDirection="column" flexGrow="1" overflow="hidden">
			<box when="!showPreviewFull" flexDirection="row" flexGrow="1" overflow="hidden">
				<box when="showParentPane" flexDirection="column" flexGrow="1" flexBasis="0" border borderStyle="single"
				     out:border="leftBorder" out:borderColor="parentBorderFg"
				     on:click="parentId!pane:activate">
					<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
						<box when="!parentFilterOn" flexGrow="1" flexShrink="1" minWidth="0" overflow="hidden">
							<breadcrumbs in:segments="parentSegments" in:paneId="parentId" height="1"></breadcrumbs>
						</box>
						<filterbar in:query="parentFilter" in:paneId="parentId" in:filtering="filtering" in:entries="parentEntries" in:setFilter="parentSetFilter"></filterbar>
					</box>
					<box height="1" out:border="headRule" out:borderColor="parentHeadRuleFg"></box>
					<filelist in:entries="parentEntries" in:cursor="parentCursor" in:marked="parentMarked"
					          in:active="parentActive" in:paneId="parentId" in:loading="parentLoading"
					          in:viewport="listViewport"></filelist>
					<entrydetail in:entry="parentEntry" in:marked="parentMarked" height="2"></entrydetail>
				</box>
				<box when="showLeftPane" flexDirection="column" flexBasis="0" out:flexGrow="leftGrow" border borderStyle="single"
				     out:border="leftBorder" out:borderColor="leftBorderFg"
				     on:click="leftId!pane:activate">
					<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
						<box when="!leftFilterOn" flexGrow="1" flexShrink="1" minWidth="0" overflow="hidden">
							<breadcrumbs in:segments="leftSegments" in:paneId="leftId" height="1"></breadcrumbs>
						</box>
						<filterbar in:query="leftFilter" in:paneId="leftId" in:filtering="filtering" in:entries="leftEntries" in:setFilter="leftSetFilter"></filterbar>
					</box>
					<box height="1" out:border="headRule" out:borderColor="leftHeadRuleFg"></box>
					<filelist in:entries="leftEntries" in:cursor="leftCursor" in:marked="leftMarked"
					          in:active="leftActive" in:paneId="leftId" in:loading="leftLoading"
					          in:viewport="listViewport"></filelist>
					<entrydetail in:entry="leftEntry" in:marked="leftMarked" height="2"></entrydetail>
				</box>
				<box when="showRightPane" flexDirection="column" flexBasis="0" out:flexGrow="rightGrow" border borderStyle="single"
				     out:border="rightBorder" out:borderColor="rightBorderFg"
				     on:click="rightId!pane:activate">
					<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
						<box when="!rightFilterOn" flexGrow="1" flexShrink="1" minWidth="0" overflow="hidden">
							<breadcrumbs in:segments="rightSegments" in:paneId="rightId" height="1"></breadcrumbs>
						</box>
						<filterbar in:query="rightFilter" in:paneId="rightId" in:filtering="filtering" in:entries="rightEntries" in:setFilter="rightSetFilter"></filterbar>
					</box>
					<box height="1" out:border="headRule" out:borderColor="rightHeadRuleFg"></box>
					<filelist in:entries="rightEntries" in:cursor="rightCursor" in:marked="rightMarked"
					          in:active="rightActive" in:paneId="rightId" in:loading="rightLoading"
					          in:viewport="listViewport"></filelist>
					<entrydetail in:entry="rightEntry" in:marked="rightMarked" height="2"></entrydetail>
				</box>
				<filepreview when="showInspectorInline" in:preview="preview" in:show="showInspectorInline"
				             in:entry="appEntry" in:paneId="previewId"
				             in:dirSegments="previewSegments" in:dirEntries="previewEntries"
				             in:dirCursor="previewCursor" in:dirMarked="previewMarked"
				             in:dirActive="previewActive" in:dirLoading="previewLoading"
				             flexGrow="1" flexBasis="0"></filepreview>
			</box>
			<!-- Maximized inspector (`⇧V`): the preview takes the whole pane
			     row, the identity and command bars staying in place. -->
			<filepreview when="showPreviewFull" in:preview="preview" in:show="showPreviewFull"
			             in:entry="appEntry" in:paneId="previewId"
			             in:dirSegments="previewSegments" in:dirEntries="previewEntries"
			             in:dirCursor="previewCursor" in:dirMarked="previewMarked"
			             in:dirActive="previewActive" in:dirLoading="previewLoading"
			             flexGrow="1"></filepreview>
			<commandbar in:items="commandBarItems" in:notice="notice" in:leftError="leftError"
			            in:rightError="rightError" in:active="active"
			            in:leftMarked="leftMarked" in:rightMarked="rightMarked" out:height="barHeight"></commandbar>
		</box>
	</box>

	<!-- Fullscreen inspector overlay: `v` below the inline breakpoint, or
	     Enter on a file the host cannot edit (any width). -->
	<box when="showViewer" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="10"
	     alignItems="center" justifyContent="center">
		<box width="80%" height="90%">
			<filepreview in:preview="preview" in:show="showViewer" in:entry="appEntry" in:paneId="previewId"
			             in:dirSegments="previewSegments" in:dirEntries="previewEntries"
			             in:dirCursor="previewCursor" in:dirMarked="previewMarked"
			             in:dirActive="previewActive" in:dirLoading="previewLoading"></filepreview>
		</box>
	</box>

	<commandpanel when="panelOpen" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="22"
	              in:open="panelOpen" in:entry="panelEntry" in:items="panelItems"
	              in:opCursor="panelOpIndex" in:rows="panelRows" in:argCursor="panelRowIndex"
	              in:labelWidth="panelLabelWidth"
	              in:focus="panelFocus"	              in:command="panelCommand" in:runnable="panelRunnable"
	              in:picking="panelPicking" in:pickerQuery="pickerQuery" in:pickerPath="pickerPath"
	              in:query="panelQuery" in:value="panelValue"></commandpanel>
	<bookmarklist when="bookmarkOpen" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="25"
	              in:open="bookmarkOpen" in:mode="bookmarkMode" in:query="bookmarkQuery"
	              in:target="bookmarkTarget" in:items="bookmarkItems" in:selected="bookmarkIndex"></bookmarklist>
	<confirm when="confirm" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="30"
	         in:confirm="confirm"></confirm>
	<help when="helpOpen" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="40"
	      in:open="helpOpen" in:size="uiSize"></help>
</box>
