<box when="open" width="100%" height="100%" alignItems="center" justifyContent="center">
	<box width="72%" height="60%" border borderStyle="rounded"
	     out:title="title" out:titleColor="titleColor" out:borderColor="borderFg"
	     out:backgroundColor="bg" flexDirection="column">
		<text when="emptyVisible" out="empty" out:fg="emptyFg" paddingLeft="1" wrapMode="none"></text>
		<scrollbox when="!emptyVisible" ref="list" flexGrow="1">
			<box out="rows" flexDirection="column"></box>
		</scrollbox>
		<box flexDirection="row" height="1" paddingLeft="1">
			<text out="footer" out:fg="footerFg"></text>
		</box>
	</box>
</box>
