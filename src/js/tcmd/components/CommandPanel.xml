<box when="open" width="100%" height="100%" alignItems="center" justifyContent="center">
	<box width="80%" height="72%" border borderStyle="rounded"
	     out:title="title" out:titleColor="titleColor" out:borderColor="borderFg"
	     out:backgroundColor="bg" flexDirection="column">
		<box flexDirection="row" flexGrow="1" overflow="hidden">
			<!-- Left pane: the `:` filter over the grouped command list. -->
			<box flexDirection="column" flexGrow="2" flexBasis="0" overflow="hidden">
				<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
					<text out="sign" out:fg="signFg" wrapMode="none"></text>
					<input ref="query" inout="query" flexGrow="1" height="1" out:focused="queryFocused"></input>
				</box>
				<box height="1" out:border="headRule" out:borderColor="ruleFg"></box>
				<scrollbox flexGrow="1">
					<box out="opRows" flexDirection="column"></box>
				</scrollbox>
			</box>
			<!-- Vertical rule between the panes. -->
			<box width="1" out:border="sideRule" out:borderColor="ruleFg"></box>
			<!-- Right pane: the command name, its arguments, the resolved command. -->
			<box flexDirection="column" flexGrow="3" flexBasis="0" overflow="hidden">
				<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
					<text out="commandName" out:fg="commandNameFg" wrapMode="none"></text>
				</box>
				<box height="1" out:border="headRule" out:borderColor="ruleFg"></box>
				<scrollbox ref="args" flexGrow="1" out:scrollTop="argScrollTop">
					<box flexDirection="column">
						<!-- File picker sub-mode: the browsed path, its own filter,
						     then the entry rows (which arrive through `argRows`). -->
						<text when="picking" out="pickerPath" out:fg="labelFg" paddingLeft="1" wrapMode="none" truncate="true"></text>
						<box when="picking" flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
							<text out="pickerSign" out:fg="signFg" wrapMode="none"></text>
							<input ref="pickQuery" inout="pickerQuery" flexGrow="1" height="1" out:focused="pickerFocused"></input>
						</box>
						<text when="argsEmpty" out="argsEmptyText" out:fg="labelFg" paddingLeft="1" wrapMode="none"></text>
						<box out="argRows" flexDirection="column"></box>
						<text when="pickerEmpty" out="pickerEmptyText" out:fg="labelFg" paddingLeft="1" wrapMode="none"></text>
					</box>
				</scrollbox>
				<box height="1" out:border="headRule" out:borderColor="ruleFg"></box>
				<box flexDirection="column" flexShrink="0" paddingLeft="1" paddingRight="1" overflow="hidden">
					<text out="preview" out:fg="previewFg" wrapMode="word"></text>
				</box>
			</box>
		</box>
		<box flexDirection="row" height="1" paddingLeft="1">
			<text out="footer" out:fg="footerFg"></text>
		</box>
	</box>
</box>
