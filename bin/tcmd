#!/bin/sh
# TinyCommand `tcmd` entry point.
if ! command -v bun >/dev/null 2>&1; then
	printf '%s\n' 'tcmd requires Bun (https://bun.sh). Install Bun, then run `bun x @ssebastien/tcmd` again.' >&2
	exit 1
fi
script=$0
case "$script" in
	*/*) ;;
	*) script=$(command -v "$script") ;;
esac
case "$script" in
	/*) ;;
	*) script=$PWD/$script ;;
esac
while [ -L "$script" ]; do
	dir=$(CDPATH= cd -P -- "$(dirname -- "$script")" && pwd)
	link=$(readlink "$script")
	case "$link" in
		/*) script=$link ;;
		*) script=$dir/$link ;;
	esac
done
dir=$(CDPATH= cd -P -- "$(dirname -- "$script")" && pwd)
exec bun "$dir/tcmd.js" "$@"
