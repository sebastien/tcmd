<box when="open" position="absolute" bottom="0" left="0" width="100%" height="8"
     out:backgroundColor="bg" border out:title="title" out:titleColor="titleColor" flexDirection="column">
	<box flexDirection="row" height="1">
		<text out="sign" out:fg="titleColor"></text>
		<input ref="query" inout="query" flexGrow="1" height="1" out:focused="focused" on:enter="confirm"></input>
	</box>
	<scrollbox ref="list" flexGrow="1" height="100%">
		<box out="rows" flexDirection="column"></box>
	</scrollbox>
</box>
