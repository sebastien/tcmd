<box when="open" width="100%" height="100%" alignItems="center" justifyContent="center">
	<box width="80%" out:height="panelHeight" border borderStyle="rounded"
	     out:title="title" out:titleColor="titleColor" out:borderColor="borderFg"
	     out:backgroundColor="bg" flexDirection="column">
		<box flexDirection="row" flexGrow="1" overflow="hidden">
			<!-- Left pane: the `:` filter over the grouped command list. -->
			<box flexDirection="column" flexGrow="2" flexBasis="0" overflow="hidden">
				<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
					<text out="sign" out:fg="signFg" wrapMode="none"></text>
					<input ref="query" inout="query" flexGrow="1" height="1" out:focused="queryFocused"></input>
				</box>
				<box height="1" out:border="headRule" out:borderColor="ruleFg"></box>
				<scrollbox ref="ops" flexGrow="1" flexShrink="1" minHeight="0" out:scrollTop="opScrollTop">
					<box out="opRows" flexDirection="column"></box>
				</scrollbox>
			</box>
			<!-- Vertical rule between the panes. -->
			<box width="1" out:border="sideRule" out:borderColor="ruleFg"></box>
			<!-- Right pane: the command name, arguments and trailing Run action. -->
			<box flexDirection="column" flexGrow="3" flexBasis="0" overflow="hidden">
				<!-- The command name heads the pane. -->
				<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
					<text out="commandName" out:fg="commandNameFg" flexGrow="1" flexShrink="1" minWidth="0" wrapMode="none" truncate="true"></text>
				</box>
				<box height="1" out:border="headRule" out:borderColor="ruleFg"></box>
				<!-- Arguments, preflight preview and the Run action share one
				     scroller, so Run lands one line below the last field rather
				     than pinned to the bottom of the pane. -->
				<scrollbox when="!picking" ref="args" flexGrow="1" flexShrink="1" minHeight="0" out:scrollTop="argScrollTop">
					<box out="argRows" flexDirection="column"></box>
					<box ref="previewBox" when="hasPreview" flexDirection="column" flexShrink="0" maxHeight="5" paddingLeft="1" overflow="hidden">
						<text out="preview" out:fg="previewFg" wrapMode="word"></text>
					</box>
					<box out="runRows" flexDirection="column" flexShrink="0" paddingLeft="1" paddingRight="1"></box>
					<box when="hasRunError" border borderStyle="single" out:borderColor="runErrorFg"
					     flexDirection="column" flexShrink="0" marginTop="1" marginLeft="1" marginRight="1"
					     paddingLeft="1" paddingRight="1">
						<text out="runError" out:fg="runErrorFg" wrapMode="word"></text>
					</box>
					<box when="hasConfirmCommand" paddingLeft="1">
						<text out="confirmCommand" out:fg="confirmCommandFg" wrapMode="word"></text>
					</box>
				</scrollbox>
				<filepicker when="picking" flexGrow="1" flexShrink="1" minHeight="0"
				            in:open="picking" in:path="pickerPathText" in:focus="pickerFocus"
				            in:rows="pickerRows" in:cursor="argCursor"></filepicker>
			</box>
		</box>
		<box flexDirection="row" height="1" paddingLeft="1">
			<text out="footer" out:fg="footerFg"></text>
		</box>
		<!-- The close action sits in the top border, upper-right, like a close
		     button; the background masks the border run underneath. -->
		<box position="absolute" top="-1" right="2" height="1" zIndex="3"
		     out:backgroundColor="bg" on:click="!panel:close.">
			<text out="closeHint" out:fg="closeHintFg" wrapMode="none"></text>
		</box>
	</box>
</box>
