<box flexDirection="row" height="1" columnGap="1" out:backgroundColor="rowBg" on:click="paneId:paneId,index:index!list:select">
	<text out="rowMarker" width="2" out:fg="rowMarkerFg"></text>
	<box flexGrow="1" minWidth="0" overflow="hidden">
		<text out="rowName" out:fg="rowNameFg" wrapMode="none" truncate="true"></text>
	</box>
	<box width="9" justifyContent="flex-end">
		<text out="rowSize" out:fg="rowSizeFg" wrapMode="none"></text>
	</box>
</box>
