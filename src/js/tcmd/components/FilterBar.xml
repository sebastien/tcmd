<box when="visible" flexDirection="row" height="1">
	<text out="prompt" out:fg="promptFg"></text>
	<input when="editing" ref="query" inout="query" out:focused="focused" flexGrow="1" height="1"></input>
	<text when="applied" out="label" out:fg="labelFg" flexGrow="1"></text>
	<text out="alert" out:fg="alertFg"></text>
</box>
