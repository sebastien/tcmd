<box ref="box" flexDirection="column" height="2" out:border="detailBorder" out:borderColor="detailBorderFg"
     borderStyle="single" overflow="hidden">
	<box flexDirection="row" height="1" overflow="hidden">
		<text when="detailHasIndent" out="detailIndent" out:fg="dimFg" wrapMode="none"></text>
		<text when="detailHasMarked" out="detailMarked" out:fg="detailMarkedFg" wrapMode="none"></text>
		<text when="detailSepTime" out="detailSep" out:fg="dimFg" wrapMode="none"></text>
		<text when="detailHasTime" out="detailTime" out:fg="brightFg" wrapMode="none"></text>
		<text when="detailSepType" out="detailSep" out:fg="dimFg" wrapMode="none"></text>
		<text when="detailHasType" out="detailType" out:fg="detailTypeFg" wrapMode="none"></text>
		<text when="detailSepSize" out="detailSep" out:fg="dimFg" wrapMode="none"></text>
		<text when="detailHasSize" out="detailSize" out:fg="brightFg" wrapMode="none"></text>
		<box when="detailHasMode" flexGrow="1" minWidth="0" flexShrink="1"></box>
		<text when="detailSepMode" out="detailSep" out:fg="dimFg" wrapMode="none" flexShrink="0"></text>
		<text when="detailHasMode" out="detailMode" out:fg="detailModeFg" wrapMode="none" flexShrink="0"></text>
	</box>
</box>
