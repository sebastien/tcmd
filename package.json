{
	"name": "@ssebastien/tcmd",
	"version": "0.1.1",
	"description": "TinyCommand: a midnight-commander-like CLI and desktop tool",
	"type": "module",
	"main": "./src/js/tcmd/index.js",
	"files": ["bin/", "src/js/tcmd/", "README.md"],
	"bin": {
		"tcmd": "./bin/tcmd"
	},
	"scripts": {
		"test": "bun test tests",
		"tcmd": "bun src/js/tcmd/tui/index.js",
		"web": "bun run web:build && bun run web:serve",
		"web:build": "bun build src/js/tcmd/web/main.js --outdir public --target browser",
		"web:serve": "bun scripts/serve-web.js"
	},
	"dependencies": {
		"@opentui/core": "0.5.9",
		"@ssebastien/select": "^1.2.1",
		"@ssebastien/select-tui": "^0.1.0"
	},
	"devDependencies": {
		"happy-dom": "^20.10.6"
	},
	"author": "Sébastien Pierre",
	"license": "BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sebastien/tcmd.git"
	},
	"engines": {
		"bun": ">=1.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
