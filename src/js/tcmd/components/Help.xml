<box when="open" width="100%" height="100%" alignItems="center" justifyContent="center">
	<box width="72%" height="82%" border borderStyle="rounded"
	     out:title="title" out:titleColor="titleFg" out:borderColor="borderFg"
	     out:backgroundColor="bg" flexDirection="column"
	     paddingLeft="2" paddingRight="2" paddingTop="1" paddingBottom="1">
		<scrollbox flexGrow="1">
			<text out="text" out:fg="textFg"></text>
		</scrollbox>
		<text out="hint" out:fg="dimFg"></text>
	</box>
</box>
