<box when="open" width="100%" height="100%" alignItems="center" justifyContent="center">
	<box width="80%" height="72%" border borderStyle="rounded"
	     out:title="title" out:titleColor="titleColor" out:borderColor="borderFg"
	     out:backgroundColor="bg" flexDirection="column">
		<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
			<text out="sign" out:fg="signFg" wrapMode="none"></text>
			<input ref="query" inout="query" flexGrow="1" height="1" out:focused="queryFocused" on:enter="confirm"></input>
		</box>
		<box flexDirection="row" flexGrow="1" overflow="hidden" columnGap="1">
			<scrollbox flexGrow="2">
				<box out="opRows" flexDirection="column"></box>
			</scrollbox>
			<scrollbox ref="args" flexGrow="3" paddingLeft="1" out:scrollTop="argScrollTop">
				<box out="argRows" flexDirection="column"></box>
			</scrollbox>
		</box>
		<box flexDirection="column" paddingLeft="1" paddingRight="1" flexShrink="0" overflow="hidden">
			<text out="previewLabel" out:fg="labelFg" wrapMode="none"></text>
			<text out="preview" out:fg="previewFg" wrapMode="word"></text>
		</box>
		<box when="fieldVisible" flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
			<text out="fieldPrompt" out:fg="labelFg" wrapMode="none"></text>
			<input inout="value" flexGrow="1" height="1" out:focused="fieldFocused" on:enter="confirm"></input>
		</box>
		<box flexDirection="row" height="1" paddingLeft="1">
			<text out="footer" out:fg="footerFg"></text>
		</box>
	</box>
</box>
