<!-- Root wrapper: the workspace, plus overlays positioned against the whole
     viewport. The overlays stay INSIDE this root box so keypress routing (which
     binds to it once) sees them as its focused subtree. -->
<box flexDirection="column" width="100%" height="100%" on:keypress="keys">

	<!-- Workspace wrapper: always mounted, so the root box has one stable
	     child whether the workspace or the min-size gate shows. -->
	<box flexGrow="1" flexDirection="column" overflow="hidden">

		<!-- Identity bar: the one visible trace of TinyCmd itself (the host
		     aside, everything else on screen is the user's files). "Tiny"
		     shimmers blue letter by letter, "Cmd" shimmers orange. -->
		<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
			<text out="brandT" out:fg="brandTFg" wrapMode="none"></text>
			<text out="brandI" out:fg="brandIFg" wrapMode="none"></text>
			<text out="brandN" out:fg="brandNFg" wrapMode="none"></text>
			<text out="brandY" out:fg="brandYFg" wrapMode="none"></text>
			<text out="brandC" out:fg="brandCFg" wrapMode="none"></text>
			<text out="brandM" out:fg="brandMFg" wrapMode="none"></text>
			<text out="brandD" out:fg="brandDFg" wrapMode="none"></text>
			<text out="topBar" out:fg="topBarFg" wrapMode="none"></text>
		</box>

		<!-- Minimum-size gate: below the breakpoint the workspace is unusable. -->
		<box when="tooSmall" flexGrow="1" alignItems="center" justifyContent="center" flexDirection="column" rowGap="1">
			<text out="minSizeTitle" out:fg="titleFg"></text>
			<text out="minSizeHint" out:fg="dimFg"></text>
		</box>

		<!-- Two boxed panes plus the inline inspector. -->
		<box when="!tooSmall" flexDirection="column" flexGrow="1" overflow="hidden">
			<box flexDirection="row" flexGrow="1" overflow="hidden">
				<box flexDirection="column" flexGrow="1" border borderStyle="single"
				     out:border="leftBorder" out:borderColor="leftBorderFg"
				     on:click="leftId!pane:activate">
					<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
						<box when="!leftFilterOn" flexGrow="1" flexShrink="1" minWidth="0" overflow="hidden">
							<breadcrumbs in:segments="leftSegments" in:paneId="leftId" height="1"></breadcrumbs>
						</box>
						<filterbar in:query="leftFilter" in:paneId="leftId" in:filtering="filtering" in:entries="leftEntries"></filterbar>
					</box>
					<box height="1" out:border="headRule" out:borderColor="leftHeadRuleFg"></box>
					<filelist in:entries="leftEntries" in:cursor="leftCursor" in:marked="leftMarked"
					          in:active="leftActive" in:paneId="leftId" in:loading="leftLoading"
					          in:viewport="listViewport"></filelist>
					<entrydetail in:entry="leftEntry" in:marked="leftMarked" height="2"></entrydetail>
					<summary in:entries="leftEntries" in:disk="leftDisk" height="1"></summary>
				</box>
				<box flexDirection="column" flexGrow="1" border borderStyle="single"
				     out:border="rightBorder" out:borderColor="rightBorderFg"
				     on:click="rightId!pane:activate">
					<box flexDirection="row" height="1" paddingLeft="1" overflow="hidden">
						<box when="!rightFilterOn" flexGrow="1" flexShrink="1" minWidth="0" overflow="hidden">
							<breadcrumbs in:segments="rightSegments" in:paneId="rightId" height="1"></breadcrumbs>
						</box>
						<filterbar in:query="rightFilter" in:paneId="rightId" in:filtering="filtering" in:entries="rightEntries"></filterbar>
					</box>
					<box height="1" out:border="headRule" out:borderColor="rightHeadRuleFg"></box>
					<filelist in:entries="rightEntries" in:cursor="rightCursor" in:marked="rightMarked"
					          in:active="rightActive" in:paneId="rightId" in:loading="rightLoading"
					          in:viewport="listViewport"></filelist>
					<entrydetail in:entry="rightEntry" in:marked="rightMarked" height="2"></entrydetail>
					<summary in:entries="rightEntries" in:disk="rightDisk" height="1"></summary>
				</box>
				<filepreview when="showInspectorInline" in:preview="preview" in:show="showInspectorInline"
				             in:entry="appEntry" flexGrow="1"></filepreview>
			</box>
			<commandbar in:items="commandBarItems" in:notice="notice" in:leftError="leftError"
			            in:rightError="rightError" in:active="active"
			            in:leftMarked="leftMarked" in:rightMarked="rightMarked" out:height="barHeight"></commandbar>
		</box>
	</box>

	<!-- Fullscreen inspector for narrow viewports. -->
	<box when="showViewer" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="10"
	     alignItems="center" justifyContent="center">
		<box width="80%" height="90%">
			<filepreview in:preview="preview" in:show="showViewer" in:entry="appEntry"></filepreview>
		</box>
	</box>

	<commandpanel when="panelOpen" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="22"
	              in:open="panelOpen" in:entry="panelEntry" in:items="panelItems"
	              in:opCursor="panelOpIndex" in:rows="panelRows" in:argCursor="panelRowIndex"
	              in:focus="panelFocus" in:textual="panelTextual" in:argRow="panelCursorRow"
	              in:command="panelCommand" in:runnable="panelRunnable"
	              in:query="panelQuery" in:value="panelValue"></commandpanel>
	<bookmarklist when="bookmarkOpen" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="25"
	              in:open="bookmarkOpen" in:mode="bookmarkMode" in:query="bookmarkQuery"
	              in:target="bookmarkTarget" in:items="bookmarkItems" in:selected="bookmarkIndex"></bookmarklist>
	<confirm when="confirm" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="30"
	         in:confirm="confirm"></confirm>
	<help when="helpOpen" position="absolute" top="0" left="0" width="100%" height="100%" zIndex="40"
	      in:open="helpOpen"></help>
</box>
